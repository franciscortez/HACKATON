# Free tier keys. Providers without a key are skipped.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Local fallback (Ollama, OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
# Optional server-only Authorization header for a protected remote Ollama endpoint.
OLLAMA_AUTHORIZATION=

# Tool 03 paid web research (bounded by per-client settings)
APIFY_API_KEY=

# Tool 06 hosted connector rollout (public build-time flag; off by default).
NEXT_PUBLIC_VIDEO_CONNECTOR_ENABLED=0
# Local connector only: exact additional browser origins, comma-separated.
# VIDEO_CONNECTOR_ORIGINS=http://localhost:3000
# VIDEO_CONNECTOR_PORT=43127
# VIDEO_WORKSPACE=
# VIDEO_PYTHON=
